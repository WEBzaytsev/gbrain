# Copy to .env and chmod 600 before running.
# Never commit the real .env.

# GBrain version to install into the locally-built image.
# Default mirrors the useful community compose pin from jiejiejlj/gbrain-docker.
# Current upstream master observed while creating this scaffold: f72de97943eb9dc1292a80f85d19db7e311855dc
GBRAIN_REF=eefe8b5741c27e59bf65198d46e3dfe5bfa70ce9
GBRAIN_IMAGE=webzaytsev-gbrain:local

GBRAIN_POSTGRES_USER=gbrain
GBRAIN_POSTGRES_PASSWORD=change-me-long-random-password
GBRAIN_POSTGRES_DB=gbrain
GBRAIN_DATABASE_URL=postgresql://gbrain:change-me-long-random-password@gbrain-db:5432/gbrain
POSTGRES_SHM_SIZE=1g

# Required for a useful embedding-enabled brain.
# For a no-spend structural smoke test, keep this empty and set GBRAIN_INIT_NO_EMBEDDING=1.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
ZEROENTROPY_API_KEY=

GBRAIN_PORT=3131
GBRAIN_BIND=0.0.0.0
GBRAIN_PUBLIC_URL=https://gbrain.example.com
GBRAIN_HTTP_CORS_ORIGIN=https://gbrain.example.com
GBRAIN_ADMIN_BOOTSTRAP_TOKEN=replace-with-random-token-at-least-32-chars
GBRAIN_TOKEN_TTL=3600

GBRAIN_SCHEMA_PACK=gbrain-base-v2
GBRAIN_INIT_NO_EMBEDDING=0
GBRAIN_INIT_EMBEDDING_MODEL=openai:text-embedding-3-large
GBRAIN_INIT_EMBEDDING_DIMENSIONS=1536
GBRAIN_INIT_SKIP_EMBED_CHECK=0

GBRAIN_WORKER_QUEUE=default
GBRAIN_WORKER_CONCURRENCY=2
GBRAIN_WORKER_MAX_RSS_MB=0
GBRAIN_AUTOPILOT_INTERVAL=300
GBRAIN_FEDERATION_INTERVAL=60
