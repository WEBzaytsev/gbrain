# Copy to .env and chmod 600 before running.
# Never commit the real .env.

# Optional image tag override. Compose uses ghcr.io/webzaytsev/gbrain:${IMAGE_TAG:-latest}.
# IMAGE_TAG=latest

GBRAIN_POSTGRES_USER=gbrain
GBRAIN_POSTGRES_PASSWORD=change-me-long-random-password
GBRAIN_POSTGRES_DB=gbrain
GBRAIN_DATABASE_URL=postgresql://gbrain:change-me-long-random-password@gbrain-db:5432/gbrain

# Required for a useful embedding-enabled brain.
# For a no-spend structural smoke test, keep this empty and set GBRAIN_INIT_NO_EMBEDDING=1.
GBRAIN_OPENAI_API_KEY=
# Optional OpenAI-compatible endpoint override. Include the /v1 suffix.
# Example: GBRAIN_OPENAI_BASE_URL=https://tokenly.plus/api/v1
GBRAIN_OPENAI_BASE_URL=
# Optional model routing for chat/query expansion through the OpenAI recipe.
# Use model ids supported by the selected endpoint.
# Example: GBRAIN_CHAT_MODEL=openai:gpt-4o-mini
GBRAIN_CHAT_MODEL=
GBRAIN_EXPANSION_MODEL=
GBRAIN_ANTHROPIC_API_KEY=
GBRAIN_VOYAGE_API_KEY=
GBRAIN_ZEROENTROPY_API_KEY=

GBRAIN_PORT=3131
GBRAIN_BIND=0.0.0.0
GBRAIN_PUBLIC_URL=https://gbrain.example.com
GBRAIN_HTTP_CORS_ORIGIN=https://gbrain.example.com
GBRAIN_ADMIN_BOOTSTRAP_TOKEN=replace-with-random-token-at-least-32-chars
GBRAIN_TOKEN_TTL=3600

GBRAIN_SCHEMA_PACK=gbrain-base-v2
GBRAIN_INIT_NO_EMBEDDING=0
GBRAIN_INIT_EMBEDDING_MODEL=openai/text-embedding-3-small
# Only set for providers/models that require an explicit or custom dimension.
# GBRAIN_INIT_EMBEDDING_DIMENSIONS=
GBRAIN_INIT_SKIP_EMBED_CHECK=0

GBRAIN_WORKER_QUEUE=default
GBRAIN_WORKER_CONCURRENCY=2
GBRAIN_WORKER_MAX_RSS_MB=0
GBRAIN_REPO=/home/gbrain/brain
GBRAIN_AUTOPILOT_INTERVAL=300
GBRAIN_FEDERATION_INTERVAL=60

# Native GBrain repo durability / auto-push. Keep empty unless running
# `gbrain sources harden`; prefer a fine-grained PAT scoped only to the brain repo.
GBRAIN_DURABILITY_SOURCE=default
GBRAIN_DURABILITY_BRANCH=main
# In Docker, keep this 0: container crontab is not the durable scheduler.
GBRAIN_DURABILITY_INSTALL_CRON=0
GBRAIN_GITHUB_PAT=
